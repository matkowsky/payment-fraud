{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "investigation_records.schema.json",
 "title": "Query-run and release records (C2 and C3)",
 "description": "Field-level schema for the records the second and third requirements need. Each record is one of the types below. Records are append-only.",
 "oneOf": [
  {
   "$ref": "#/$defs/Actor"
  },
  {
   "$ref": "#/$defs/QueryRun"
  },
  {
   "$ref": "#/$defs/Observation"
  },
  {
   "$ref": "#/$defs/DraftOutput"
  },
  {
   "$ref": "#/$defs/OutputExposure"
  },
  {
   "$ref": "#/$defs/ReleaseDecision"
  },
  {
   "$ref": "#/$defs/ReleasedItem"
  },
  {
   "$ref": "#/$defs/MemoryRead"
  }
 ],
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._:-]+$"
  },
  "timestamp": {
   "type": "string",
   "format": "date-time"
  },
  "entity": {
   "description": "An entity with its tenant and identifier namespace.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tenant",
    "namespace",
    "id"
   ],
   "properties": {
    "tenant": {
     "$ref": "#/$defs/id"
    },
    "namespace": {
     "$ref": "#/$defs/id"
    },
    "id": {
     "$ref": "#/$defs/id"
    }
   }
  },
  "interval": {
   "description": "A closed event-time interval.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "from",
    "to"
   ],
   "properties": {
    "from": {
     "$ref": "#/$defs/timestamp"
    },
    "to": {
     "$ref": "#/$defs/timestamp"
    }
   }
  },
  "source_coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_id",
    "schema_version",
    "access",
    "event_watermark",
    "ingestion_watermark",
    "retention_horizon",
    "known_gaps",
    "sampled"
   ],
   "properties": {
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "schema_version": {
     "type": "string",
     "minLength": 1
    },
    "access": {
     "enum": [
      "evaluated",
      "denied",
      "unavailable"
     ]
    },
    "event_watermark": {
     "$ref": "#/$defs/timestamp"
    },
    "ingestion_watermark": {
     "$ref": "#/$defs/timestamp"
    },
    "retention_horizon": {
     "$ref": "#/$defs/timestamp"
    },
    "known_gaps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/interval"
     }
    },
    "sampled": {
     "type": "boolean"
    }
   }
  },
  "claim": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "claim_id",
    "claim_type",
    "material",
    "entities",
    "interval",
    "confidence",
    "supporting",
    "contradicting",
    "query_runs",
    "context",
    "independent_roots"
   ],
   "properties": {
    "claim_id": {
     "$ref": "#/$defs/id"
    },
    "claim_type": {
     "enum": [
      "presence",
      "absence",
      "current_conduct"
     ]
    },
    "material": {
     "type": "boolean"
    },
    "entities": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/entity"
     }
    },
    "interval": {
     "$ref": "#/$defs/interval"
    },
    "confidence": {
     "enum": [
      "low",
      "moderate",
      "high"
     ]
    },
    "supporting": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "contradicting": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "query_runs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "context": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "independent_roots": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "Actor": {
   "description": "A party that writes records: an agent, the gateway, a checker or a person.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "kind"
   ],
   "properties": {
    "record_type": {
     "const": "Actor"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "kind": {
     "enum": [
      "agent",
      "gateway",
      "checker",
      "human"
     ]
    }
   }
  },
  "QueryRun": {
   "description": "One query the agent asked for, with the coverage record the gateway attached: what was requested and evaluated, the as-of cutoff, and each source's watermarks, gaps, retention and sampling.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "case_id",
    "requested_by",
    "recorded_by",
    "issued_at",
    "as_of",
    "requested_entities",
    "evaluated_entities",
    "requested_interval",
    "evaluated_interval",
    "sources",
    "access_filter_removed_rows",
    "limits_reached",
    "scope_limited",
    "returned",
    "statuses"
   ],
   "properties": {
    "record_type": {
     "const": "QueryRun"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "case_id": {
     "$ref": "#/$defs/id"
    },
    "requested_by": {
     "$ref": "#/$defs/id"
    },
    "recorded_by": {
     "$ref": "#/$defs/id"
    },
    "issued_at": {
     "$ref": "#/$defs/timestamp"
    },
    "as_of": {
     "$ref": "#/$defs/timestamp"
    },
    "requested_entities": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/entity"
     }
    },
    "evaluated_entities": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/entity"
     }
    },
    "requested_interval": {
     "$ref": "#/$defs/interval"
    },
    "evaluated_interval": {
     "$ref": "#/$defs/interval"
    },
    "sources": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/source_coverage"
     }
    },
    "access_filter_removed_rows": {
     "type": "boolean"
    },
    "limits_reached": {
     "type": "array",
     "items": {
      "enum": [
       "row",
       "time",
       "cost"
      ]
     }
    },
    "scope_limited": {
     "type": "boolean"
    },
    "returned": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "statuses": {
     "type": "array",
     "minItems": 1,
     "items": {
      "enum": [
       "complete",
       "partial",
       "truncated",
       "denied",
       "unavailable"
      ]
     }
    }
   }
  },
  "Observation": {
   "description": "A stored record with its class, event interval, learned time, root observations and inputs, and links to any agent output that informed it.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "record_class",
    "entity",
    "event_interval",
    "learned_at",
    "root_ids",
    "inputs",
    "agent_output_links"
   ],
   "properties": {
    "record_type": {
     "const": "Observation"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "record_class": {
     "enum": [
      "source_observation",
      "normalized_observation",
      "derived_feature",
      "score",
      "control_decision",
      "human_note"
     ]
    },
    "entity": {
     "$ref": "#/$defs/entity"
    },
    "event_interval": {
     "$ref": "#/$defs/interval"
    },
    "learned_at": {
     "$ref": "#/$defs/timestamp"
    },
    "root_ids": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "inputs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "agent_output_links": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "author": {
     "$ref": "#/$defs/id"
    }
   }
  },
  "DraftOutput": {
   "description": "An agent draft: its exact version, expiry, the task's current period, and each claim with its supporting and contradicting records, query runs and context.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "case_id",
    "agent",
    "version_hash",
    "created_at",
    "expires_at",
    "current_period",
    "claims"
   ],
   "properties": {
    "record_type": {
     "const": "DraftOutput"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "case_id": {
     "$ref": "#/$defs/id"
    },
    "agent": {
     "$ref": "#/$defs/id"
    },
    "version_hash": {
     "type": "string",
     "pattern": "^[0-9a-f]{8,64}$"
    },
    "created_at": {
     "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
     "$ref": "#/$defs/timestamp"
    },
    "current_period": {
     "$ref": "#/$defs/interval"
    },
    "claims": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/claim"
     }
    }
   }
  },
  "OutputExposure": {
   "description": "A period in which a person had an agent output open about an entity.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "output_id",
    "viewer",
    "entity",
    "opened_at",
    "closed_at"
   ],
   "properties": {
    "record_type": {
     "const": "OutputExposure"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "output_id": {
     "$ref": "#/$defs/id"
    },
    "viewer": {
     "$ref": "#/$defs/id"
    },
    "entity": {
     "$ref": "#/$defs/entity"
    },
    "opened_at": {
     "$ref": "#/$defs/timestamp"
    },
    "closed_at": {
     "$ref": "#/$defs/timestamp"
    }
   }
  },
  "ReleaseDecision": {
   "description": "A person's decision on one exact draft version: the claims released with their confidence, scope, expiry and reviewer findings.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "draft_id",
    "version_hash",
    "decided_by",
    "decided_at",
    "decision",
    "claims",
    "scope",
    "expires_at",
    "reviewer_findings"
   ],
   "properties": {
    "record_type": {
     "const": "ReleaseDecision"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "draft_id": {
     "$ref": "#/$defs/id"
    },
    "version_hash": {
     "type": "string",
     "pattern": "^[0-9a-f]{8,64}$"
    },
    "decided_by": {
     "$ref": "#/$defs/id"
    },
    "decided_at": {
     "$ref": "#/$defs/timestamp"
    },
    "decision": {
     "enum": [
      "released",
      "returned"
     ]
    },
    "claims": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "claim_id",
       "confidence"
      ],
      "properties": {
       "claim_id": {
        "$ref": "#/$defs/id"
       },
       "confidence": {
        "enum": [
         "low",
         "moderate",
         "high"
        ]
       }
      }
     }
    },
    "scope": {
     "type": "string",
     "minLength": 1
    },
    "expires_at": {
     "$ref": "#/$defs/timestamp"
    },
    "reviewer_findings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "ReleasedItem": {
   "description": "A released conclusion in organizational memory. It is usable as context or hypothesis only.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "release_id",
    "draft_id",
    "claim_id",
    "created_at",
    "usable_as"
   ],
   "properties": {
    "record_type": {
     "const": "ReleasedItem"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "release_id": {
     "$ref": "#/$defs/id"
    },
    "draft_id": {
     "$ref": "#/$defs/id"
    },
    "claim_id": {
     "$ref": "#/$defs/id"
    },
    "created_at": {
     "$ref": "#/$defs/timestamp"
    },
    "usable_as": {
     "const": "context"
    }
   }
  },
  "MemoryRead": {
   "description": "One read of a released item by an agent or person.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_type",
    "record_id",
    "case_id",
    "reader",
    "item_id",
    "read_at"
   ],
   "properties": {
    "record_type": {
     "const": "MemoryRead"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "case_id": {
     "$ref": "#/$defs/id"
    },
    "reader": {
     "$ref": "#/$defs/id"
    },
    "item_id": {
     "$ref": "#/$defs/id"
    },
    "read_at": {
     "$ref": "#/$defs/timestamp"
    }
   }
  }
 }
}
